# Home-Repo: nur Projektdateien tracken, alles andere ignorieren.
# Whitelist-Muster: erst alles ausschliessen, dann Projektteile freigeben.
/*

# --- Projekt: Crawler + Deploy ---
!/astro_crawler.py
!/data_sanity.py
!/astro_deploy.sh
!/locations.json.example
!/tests/
!/LESSONS.md
!/SYSTEM_AUDIT.md
!/README.md
!/messier.csv
!/.gitignore
!/.gitattributes
/.env
!/.env.example

# --- Projekt: PWA/Backend ---
!/astro-app/
/astro-app/tilecache/
/astro-app/verification-screenshots/
/astro-app/deviations.csv
/astro-app/backend/__pycache__/
!/docs/
!/app/

# Bytecode niemals versionieren (Whitelist gab Verzeichnisse inkl. __pycache__ frei)
__pycache__/
*.pyc

# Equipment-Inventar: echte Datei gitignored, Example committed (wie locations)
/equipment.json
!/equipment.json.example

# Native: Build-Artefakte + node_modules nicht ins Repo
/astro-app/native/node_modules/
/astro-app/native/android/.gradle/
/astro-app/native/android/app/build/
/astro-app/native/android/build/
/astro-app/native/android/local.properties
!/APP_CAPABILITIES.md
!/IGEL_ARCHITECTURE.md
