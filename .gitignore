# Home-Repo: nur Projektdateien tracken, alles andere ignorieren.
# Whitelist-Muster: erst alles ausschliessen, dann Projektteile freigeben.
/*

# --- Projekt: Crawler + Deploy ---
!/astro_crawler.py
!/data_sanity.py
!/astro_deploy.sh
!/locations.json.example
!/tests/
!/LESSONS.md
!/messier.csv
!/.gitignore
!/.gitattributes
/.env
!/.env.example

# --- Projekt: PWA/Backend ---
!/astro-app/
/astro-app/tilecache/
/astro-app/verification-screenshots/
/astro-app/deviations.csv
/astro-app/backend/__pycache__/
!/docs/
!/app/

# Bytecode niemals versionieren (Whitelist gab Verzeichnisse inkl. __pycache__ frei)
__pycache__/
*.pyc
