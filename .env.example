# =====================================================================
# Astro Cortex - Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env — .gitignore protects it, but verify before pushing.
# =====================================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather
TELEGRAM_CHAT_ID=replace-with-your-chat-id

# --- Server ---
HOST=0.0.0.0
PORT=8000
# Tailscale hostname or IP for remote access; bind locally otherwise
TAILSCALE_INTERFACE=tailscale0

# --- Database ---
DB_PATH=/var/lib/astro-cortex/cortex.db
STATE_DIR=/var/lib/astro-cortex/state

# --- Ephemeris (Skyfield) ---
# de421.bsp is downloaded automatically by Skyfield on first run.
# Override the cache directory only if you need a non-default location.
SKYFIELD_DATA_DIR=/var/lib/astro-cortex/skyfield-data

# --- Crawling ---
USER_AGENT=astro-cortex/0.1 (contact: your-email@example.com)
HEAVY_CRAWL_INTERVAL_MIN=30
RADAR_INTERVAL_MIN=5
# Daily milestone check runs once per day, anchored to this local time
MILESTONE_CHECK_HOUR=12

# --- Locations ---
# Comma-separated list of location IDs; details live in DB
ACTIVE_LOCATIONS=home,bischofswiesen,wendelstein,arber

# --- Rating thresholds (defaults; override per-mode in code) ---
# DSO mode
DSO_CLOUD_MAX=25          # percent
DSO_SEEING_MAX=2.5        # arcseconds
DSO_DEW_DELTA_MIN=3.0     # °C (difference between ambient and dew point)
DSO_WIND_MAX=20           # km/h sustained
DSO_JETSTREAM_MAX=30      # m/s at 300 hPa

# Planetary mode (higher tolerances)
PLANETARY_CLOUD_MAX=40
PLANETARY_SEEING_MAX=4.0
PLANETARY_DEW_DELTA_MIN=2.0
PLANETARY_WIND_MAX=30

# --- Alert escalation ---
WIND_WARNING_KMH=45
WIND_DANGER_KMH=60
COOLDOWN_MINUTES=15

# --- Logging ---
LOG_LEVEL=INFO
# DEBUG for development, INFO for production, WARNING for quiet operation

# --- Optional: external API keys (only if you add paid sources later) ---
# METEOBLUE_API_KEY=
# OPENWEATHER_API_KEY=
