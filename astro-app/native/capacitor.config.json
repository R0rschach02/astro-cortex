{
  "appId": "de.astrocortex.app",
  "appName": "Astro Cortex",
  "webDir": "../frontend",
  "android": {
    "allowMixedContent": false
  },
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "api.teamigel.com",
      "*.cloudflareaccess.com"
    ]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorUpdater": {
      "autoUpdate": false
    }
  }
}